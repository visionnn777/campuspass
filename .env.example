# Copy to .env and fill in real values:  Copy-Item .env.example .env
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (run it twice: JWT_SECRET and TICKET_SECRET must be different)

APP_ENV=development
DATABASE_URL=postgresql+psycopg://campuspass:CHANGE_ME@localhost:5432/campuspass
TEST_DATABASE_URL=postgresql+psycopg://campuspass:CHANGE_ME@localhost:5432/campuspass_test

JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_48
JWT_ISSUER=campuspass
JWT_AUDIENCE=campuspass-api
ACCESS_TOKEN_MINUTES=30

TICKET_SECRET=CHANGE_ME_a_different_token_urlsafe_48_value

RATE_LIMITS_ENABLED=true
# Optional: restrict signups to your college domain(s), comma-separated. Empty = any domain.
ALLOWED_EMAIL_DOMAINS=

MAX_BODY_BYTES=65536
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
